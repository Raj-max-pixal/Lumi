{
  "rules": {
    ".read": false,
    ".write": false,
    "publicProfiles": {
      ".read": true,
      "$uid": {
        ".write": "auth !== null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name', 'avatar', 'username'])"
      }
    },
    "privateProfiles": {
      "$uid": {
        ".read": "auth !== null && auth.uid === $uid",
        ".write": "auth !== null && auth.uid === $uid"
      }
    },
    "community": {
      "posts": {
        ".read": true,
        "$postId": {
          ".write": "auth !== null && !data.exists() && newData.child('authorId').val() === auth.uid",
          ".validate": "newData.hasChildren(['authorId', 'authorName', 'caption', 'createdAt'])",
          "likedBy": {
            "$uid": { ".write": "auth !== null && auth.uid === $uid", ".validate": "newData.val() === true" }
          },
          "savedBy": {
            "$uid": { ".write": "auth !== null && auth.uid === $uid", ".validate": "newData.val() === true" }
          },
          "comments": {
            "$commentId": {
              ".write": "auth !== null && ((!data.exists() && newData.child('authorId').val() === auth.uid) || (data.child('authorId').val() === auth.uid && !newData.exists()))",
              ".validate": "newData.hasChildren(['authorId', 'body', 'createdAt']) && newData.child('body').isString() && newData.child('body').val().length <= 2000"
            }
          }
        }
      }
    },
    "hackathon": {
      "projects": {
        ".read": true,
        "$projectId": {
          ".write": "auth !== null && !data.exists() && newData.child('authorId').val() === auth.uid",
          ".validate": "newData.hasChildren(['authorId', 'authorName', 'title', 'websiteUrl', 'githubUrl', 'description', 'createdAt']) && newData.child('title').isString() && newData.child('title').val().length <= 100 && newData.child('description').isString() && newData.child('description').val().length <= 3000 && newData.child('websiteUrl').isString() && newData.child('githubUrl').isString() && newData.child('createdAt').isNumber()",
          "votes": {
            "$uid": {
              ".write": "auth !== null && auth.uid === $uid && root.child('hackathon').child('projects').child($projectId).exists()",
              ".validate": "newData.val() === 'yes' || newData.val() === 'no'"
            }
          }
        }
      },
      "servers": {
        ".read": true,
        "$serverId": {
          ".write": "auth !== null && !data.exists() && newData.child('ownerId').val() === auth.uid",
          ".validate": "newData.hasChildren(['ownerId', 'name', 'details', 'domain', 'createdAt']) && newData.child('name').isString() && newData.child('name').val().length <= 80 && newData.child('details').isString() && newData.child('details').val().length <= 500 && newData.child('domain').isString() && newData.child('domain').val().length <= 80",
          "messages": {
            "$messageId": {
              ".write": "auth !== null && !data.exists() && newData.child('authorId').val() === auth.uid && root.child('hackathon').child('servers').child($serverId).child('members').child(auth.uid).val() === true",
              ".validate": "newData.hasChildren(['authorId', 'authorName', 'text', 'createdAt']) && newData.child('text').isString() && newData.child('text').val().length <= 1000"
            }
          },
          "members": {
            "$uid": {
              ".write": "auth !== null && auth.uid === $uid && !data.exists() && root.child('hackathon').child('servers').child($serverId).exists()",
              ".validate": "newData.val() === true"
            }
          }
        }
      }
    },
    "stories": {
      ".read": true,
      "$storyId": {
        ".write": "auth !== null && !data.exists() && newData.child('authorId').val() === auth.uid",
        ".validate": "newData.hasChildren(['authorId', 'mediaUrl', 'createdAt', 'expiresAt']) && newData.child('expiresAt').val() <= now + 86400000"
      }
    },
    "relationships": {
      "following": {
        ".read": true,
        "$uid": { "$targetId": { ".write": "auth !== null && auth.uid === $uid" } }
      },
      "followers": {
        ".read": true,
        "$uid": { "$sourceId": { ".write": "auth !== null && auth.uid === $sourceId" } }
      }
    },
    "notifications": {
      "$uid": {
        ".read": "auth !== null && auth.uid === $uid",
        "$notificationId": {
          ".write": "auth !== null && !data.exists()",
          ".validate": "newData.hasChildren(['title', 'body', 'createdAt'])"
        }
      }
    },
    "directMessages": {
      "$roomId": {
        ".read": "auth !== null && data.child('participants').child(auth.uid).val() === true",
        "participants": {
          ".write": "auth !== null && !data.exists() && newData.child(auth.uid).val() === true"
        },
        "messages": {
          "$messageId": {
            ".write": "auth !== null && root.child('directMessages').child($roomId).child('participants').child(auth.uid).val() === true && !data.exists() && newData.child('senderId').val() === auth.uid",
            ".validate": "newData.hasChildren(['senderId', 'text', 'createdAt']) && newData.child('text').isString() && newData.child('text').val().length <= 2000"
          }
        }
      }
    }
  }
}
