# Copy the remaining public web app values from Firebase Console > Project settings > Your apps.
# Do not reuse values from the previous Lumi Firebase project.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://lumi-f0d6b-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=lumi-f0d6b
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional server-only key: enables automatic YouTube developer-video discovery.
# Enable YouTube Data API v3 in Google Cloud, then set this in Vercel project settings.
YOUTUBE_API_KEY=

# Optional server-only Ollama Cloud key for Lumi AI. Never prefix with NEXT_PUBLIC_.
# Use Ollama's Free plan without buying credits to stay within the $0 budget.
OLLAMA_API_KEY=
# Optional; gemma4:31b is the default cloud model used by the chat route.
OLLAMA_MODEL=gemma4:31b
